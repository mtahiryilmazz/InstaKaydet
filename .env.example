# Gemini API (optional; used by AI features)
GEMINI_API_KEY=""

# Public base URL of the application (if required by your deployment)
APP_URL="http://localhost:3000"

# Instagram OAuth — leave empty until you configure an Instagram app in Meta.
# The server never reports a successful connection without a real token exchange.
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
# Must exactly match the callback URL registered with Meta.
# Example: http://localhost:3000/api/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=""
